{
  "openapi": "3.0.3",
  "info": {
    "title": "ThirdFlare One local API",
    "version": "0.2.2",
    "description": "Control-plane contract for the Node daemon. Validated in Plane M CI against a mock warp-cli."
  },
  "servers": [{ "url": "http://127.0.0.1:4173" }],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "app", "version"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "app": { "type": "string", "enum": ["thirdflare"] },
                    "version": { "type": "string" },
                    "webuiEnabled": { "type": "boolean" },
                    "effectivePort": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/version": {
      "get": {
        "summary": "Installed version and update source",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "version", "channel", "source"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "version": { "type": "string" },
                    "channel": { "type": "string" },
                    "source": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/account": {
      "get": {
        "summary": "Structured registration",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["registered", "consumer", "devices"],
                  "properties": {
                    "registered": { "type": "boolean" },
                    "consumer": { "type": "boolean" },
                    "zeroTrust": { "type": "boolean" },
                    "accountType": {},
                    "deviceId": {},
                    "license": {},
                    "devices": { "type": "array" },
                    "nextSteps": { "type": "array" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/snapshot": {
      "get": {
        "summary": "Aggregated warp-cli snapshot",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["daemon", "status", "commands"],
                  "properties": {
                    "daemon": { "type": "object" },
                    "status": { "type": "object" },
                    "commands": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/killswitch": {
      "get": {
        "summary": "Kill-switch state",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["desired", "interface", "enrollmentPause"],
                  "properties": {
                    "desired": { "type": "boolean" },
                    "active": {},
                    "allowLan": { "type": "boolean" },
                    "interface": { "type": "string" },
                    "enrollmentPause": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Effective config",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "config"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "config": { "type": "object" },
                    "sources": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/config/tray-shell": {
      "post": {
        "summary": "Persist desktop shell (cloudflare or thirdflare)",
        "responses": {
          "403": {
            "description": "Cross-site write rejected (no CSRF token; loopback only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "error"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "config"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "config": { "type": "object" },
                    "sync": { "type": "object" },
                    "liveSwap": { "type": "object" },
                    "notifications": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/action": {
      "post": {
        "summary": "Whitelisted warp-cli mutation",
        "responses": {
          "403": {
            "description": "Cross-site write rejected (no CSRF token; loopback only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "error"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "result"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "result": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/logs": {
      "get": {
        "summary": "In-memory warp-cli command log",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "entries", "capacity"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "entries": { "type": "array" },
                    "capacity": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/config/tray-autostart": {
      "post": {
        "summary": "Persist ThirdFlare One tray autostart preference",
        "responses": {
          "403": {
            "description": "Cross-site write rejected (no CSRF token; loopback only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "error"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "config"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "config": { "type": "object" },
                    "sync": { "type": "object" },
                    "active": { "type": "string", "enum": ["cloudflare", "thirdflare"] },
                    "effective": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/config/session": {
      "post": {
        "summary": "Set session-only config overrides",
        "responses": {
          "403": {
            "description": "Cross-site write rejected (no CSRF token; loopback only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "error"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/config/webui": {
      "post": {
        "summary": "Persist Web UI enable / allowRemote (restart required)",
        "responses": {
          "403": {
            "description": "Cross-site write rejected (no CSRF token; loopback only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "error"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/config/server": {
      "post": {
        "summary": "Persist HTTP port and bind (restart required)",
        "responses": {
          "403": {
            "description": "Cross-site write rejected (no CSRF token; loopback only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "error"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/config/ui": {
      "post": {
        "summary": "Persist UI preferences such as notifications",
        "responses": {
          "403": {
            "description": "Cross-site write rejected (no CSRF token; loopback only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "error"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/update/source": {
      "post": {
        "summary": "Persist or session-override the update source",
        "responses": {
          "403": {
            "description": "Cross-site write rejected (no CSRF token; loopback only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "error"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/update/prepare": {
      "post": {
        "summary": "Prepare an update and return an apply token",
        "responses": {
          "403": {
            "description": "Cross-site write rejected (no CSRF token; loopback only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "error"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/update/apply": {
      "post": {
        "summary": "Apply a prepared update",
        "responses": {
          "403": {
            "description": "Cross-site write rejected (no CSRF token; loopback only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "error"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/apps/proxy-launcher": {
      "post": {
        "summary": "Create a per-app proxy launcher",
        "responses": {
          "403": {
            "description": "Cross-site write rejected (no CSRF token; loopback only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "error"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/killswitch": {
      "post": {
        "summary": "Enable or disable the nftables kill switch",
        "responses": {
          "403": {
            "description": "Cross-site write rejected (no CSRF token; loopback only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "error"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/killswitch/enrollment-pause": {
      "post": {
        "summary": "Pause or resume the kill switch for enrollment",
        "responses": {
          "403": {
            "description": "Cross-site write rejected (no CSRF token; loopback only)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "error"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "error": { "type": "string" }
                  }
