#!/usr/bin/env bash
# NetworkManager dispatcher: connect/disconnect Cloudflare WARP when ThirdFlare VPN profiles activate.
set -euo pipefail

CONNECTION_ID="${1:-}"
ACTION="${2:-}"

[[ -n "$CONNECTION_ID" && -n "$ACTION" ]] || exit 0

case "$CONNECTION_ID" in
  "ThirdFlare WARP (MASQUE)"|\
  "ThirdFlare WARP (WireGuard)"|\
  "ThirdFlare WARP (Local proxy)")
    ;;
  *)
    exit 0
    ;;
esac

APP_ROOT="${THIRDFLARE_ONE_HOME:-/usr/lib/thirdflare}"
if [[ ! -d "$APP_ROOT" && -d "$HOME/.local/share/thirdflare-one" ]]; then
  APP_ROOT="$HOME/.local/share/thirdflare-one"
fi

HELPER="${APP_ROOT}/scripts/thirdflare-warp-connect"
if [[ ! -x "$HELPER" ]]; then
  echo "thirdflare-warp dispatcher: missing ${HELPER}" >&2
  exit 1
fi

case "$ACTION" in
  vpn-up|up)
    exec "$HELPER" up "$CONNECTION_ID"
    ;;
  vpn-down|down)
    exec "$HELPER" down "$CONNECTION_ID"
    ;;
  *)
    exit 0
    ;;
esac
