<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>ThirdFlare One</vendor>
  <vendor_url>https://github.com/bodencrouch/thirdflare-one</vendor_url>

  <action id="com.thirdflare.one.nft-apply">
    <description>Apply ThirdFlare One kill switch nftables rules</description>
    <message>Authentication is required to update the ThirdFlare One WARP kill switch</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/thirdflare/scripts/thirdflare-nft-apply</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
