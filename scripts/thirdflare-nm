#!/usr/bin/env bash
# Install ThirdFlare WARP NetworkManager profiles for KDE Plasma / NM integration.
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/common.sh
source "${ROOT}/scripts/lib/common.sh"

INSTALL_DIR="${THIRDFLARE_ONE_HOME:-$(thirdflare_default_install_dir)}"
SCOPE="user"
RELOAD_NM=1

usage() {
  cat <<USAGE
Install Cloudflare WARP NetworkManager profiles (MASQUE, WireGuard, local proxy).

These appear in KDE System Settings → Network and the Plasma Networks widget.
Use "Import VPN connection" or connect from the connection list.

Usage:
  $(basename "$0") [options]

Options:
  --user          Install to ~/.config/NetworkManager (default)
  --system        Install dispatcher + sysctl via pkexec (requires admin)
  --install-dir   ThirdFlare app root (default: local install dir)
  --no-reload     Skip nmcli reload
  -h, --help      Show help
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --user) SCOPE="user"; shift ;;
    --system) SCOPE="system"; shift ;;
    --install-dir) INSTALL_DIR="$2"; shift 2 ;;
    --no-reload) RELOAD_NM=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

thirdflare_require_command node
if ! command -v nmcli >/dev/null 2>&1; then
  echo "NetworkManager (nmcli) is required for KDE/Plasma network integration." >&2
  exit 1
fi

NM_USER_DIR="${HOME}/.config/NetworkManager/system-connections"
NM_SHARE_DIR="${INSTALL_DIR}/packaging/networkmanager/profiles"
DISPATCHER_SRC="${INSTALL_DIR}/packaging/networkmanager/99-thirdflare-warp"
DISPATCHER_DST="/etc/NetworkManager/dispatcher.d/99-thirdflare-warp"
SYSCTL_SRC="${INSTALL_DIR}/packaging/sysctl/99-thirdflare-warp.conf"
SYSCTL_DST="/etc/sysctl.d/99-thirdflare-warp.conf"
VPN_NAME_SRC="${INSTALL_DIR}/packaging/networkmanager/nm-thirdflare-warp-service.name"
VPN_NAME_DST="/usr/lib/NetworkManager/VPN/nm-thirdflare-warp-service.name"

chmod +x "${INSTALL_DIR}/scripts/thirdflare-warp-connect" 2>/dev/null || true
chmod +x "${INSTALL_DIR}/scripts/thirdflare-kde-proxy-sync" 2>/dev/null || true

echo "Generating NetworkManager profiles..."
mkdir -p "$NM_SHARE_DIR" "$NM_USER_DIR"
THIRDFLARE_NM_SHARE="$NM_SHARE_DIR" THIRDFLARE_NM_USER="$NM_USER_DIR" \
  node "${INSTALL_DIR}/scripts/sync-nm-profiles.mjs"

if [[ "$SCOPE" == "system" ]]; then
  if ! command -v pkexec >/dev/null 2>&1; then
    echo "pkexec required for --system install" >&2
    exit 1
  fi
  pkexec env THIRDFLARE_ONE_HOME="$INSTALL_DIR" bash -c "
    set -euo pipefail
    install -D -m 0755 '${INSTALL_DIR}/scripts/thirdflare-warp-connect' '/usr/local/bin/thirdflare-warp-connect'
    install -D -m 0755 '${DISPATCHER_SRC}' '${DISPATCHER_DST}'
    install -D -m 0644 '${SYSCTL_SRC}' '${SYSCTL_DST}'
    install -D -m 0644 '${VPN_NAME_SRC}' '${VPN_NAME_DST}'
    sysctl --system >/dev/null 2>&1 || sysctl -p '${SYSCTL_DST}' >/dev/null 2>&1 || true
    echo 'Installed system NetworkManager dispatcher and sysctl drop-in.'
  "
else
  echo "Tip: run $(basename "$0") --system once (with pkexec) so KDE connect/disconnect hooks work system-wide."
fi

if [[ "$RELOAD_NM" -eq 1 ]]; then
  for profile in "${NM_USER_DIR}"/ThirdFlare-WARP-*.nmconnection; do
    [[ -f "$profile" ]] || continue
    nmcli connection load "$profile" >/dev/null 2>&1 || true
  done
  nmcli connection reload >/dev/null 2>&1 || true
fi

echo "ThirdFlare WARP network profiles ready."
echo "  Import: System Settings → Network → + → Import VPN connection…"
echo "  Or pick: ThirdFlare WARP (MASQUE | WireGuard | Local proxy) in the connection list."
echo "  Docs: ${INSTALL_DIR}/docs/NETWORKING.md"
